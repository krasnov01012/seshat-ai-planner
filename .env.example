# Скопировать в .env и заполнить. Реальные значения в репозиторий не попадают.
# Для production используйте отдельное secret-хранилище с минимальными правами.

# --- Telegram ---
# Разные боты для разработки и боевой эксплуатации. Один токен на две среды
# использовать нельзя: два процесса long polling перехватывают обновления друг у друга.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- NVIDIA NIM ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_FALLBACK=nvidia/nvidia-nemotron-nano-9b-v2
NVIDIA_MODEL_FALLBACK_2=z-ai/glm-5.2
NVIDIA_TIMEOUT_S=25
NVIDIA_TOTAL_TIMEOUT_S=75
NVIDIA_MAX_RETRIES=3
NVIDIA_MAX_CONCURRENCY=1

# --- HTTP API ---
API_HOST=0.0.0.0
API_PORT=8082
# Bearer-токен. Пустой = защищённые ручки отвечают 503, а не пускают без проверки.
API_TOKEN=

# --- Готовность к обратному прокси ---
# Заполняйте только после настройки собственного TLS ingress.
PUBLIC_BASE_URL=
TRUST_PROXY_HEADERS=false
FORWARDED_ALLOW_IPS=127.0.0.1
# Список origin через запятую. Пусто = CORS выключен. Ставить * нельзя.
CORS_ORIGINS=

# --- База данных ---
POSTGRES_USER=seshat
POSTGRES_PASSWORD=
POSTGRES_DB=seshat
DATABASE_URL=postgresql+asyncpg://seshat:@postgres:5432/seshat

# --- Планировщик ---
TICK_INTERVAL_S=30
MATERIALIZE_HORIZON_DAYS=14
LATE_DELIVERY_THRESHOLD_MIN=30
# JSON arrays: preliminary offsets in minutes; the main notification is implicit.
DEFAULT_EVENT_REMINDERS_MIN=[15]
DEFAULT_TASK_REMINDERS_MIN=[120]
DEFAULT_TASK_MORNING_LOCAL=08:00
DEFAULT_ROUTINE_REMINDERS_MIN=[]
DELIVERY_BATCH_SIZE=20
DELIVERY_RETRY_BASE_S=30
DELIVERY_RETRY_MAX_S=900
DELIVERY_MAX_ATTEMPTS=5
IMPORTANT_REPEAT_INTERVAL_MIN=15
IMPORTANT_REPEAT_MAX=3
ACTIVE_CONTEXT_TTL_MIN=180
SCHEDULER_SHUTDOWN_TIMEOUT_S=20

# --- Пользователь по умолчанию ---
DEFAULT_TZ=Europe/Moscow

# --- Google Calendar (этап 7, до него не заполняется) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Прочее ---
LOG_LEVEL=INFO
ENV=dev
